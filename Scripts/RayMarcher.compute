#pragma kernel CloudRaymarch

Texture3D<float2> ShapeTexture;
Texture3D<float> DetailTexture;
Texture2D<float4> BlueNoise;
SamplerState sampler_Trilinear_repeat;

float4x4 _CameraToWorldPerEye[2];
float4x4 _CameraInvProjPerEye[2];
float4x4 _CurrViewProj[2];

RWTexture2DArray<float3> _CloudColorBuffer;
RWTexture2DArray<float>  _CloudAlphaBuffer;
Texture2DArray<float>    _DepthTex;
RWTexture2DArray<float>  _CloudDepthTex;

float2 _Resolution;
float2 _FullResolution;
uint _FrameIndex;
int _BigDivider;
uint _FlipY;

cbuffer _CloudSettings {
    float3 Offset;
    float _pad0;
    float3 Scale;
    float _pad1;
    float CloudDensity;
    float BrightnesMultiplier;
    float TransmittanceFalloff;
    float PowderStrength;
    float AmbiantLight;
    float SunBlindingEffectSize;
    float _pad4;
    float _pad5;
    float3 SunColor;
    float SunIntensity;
    float3 SunDirection;
    float CLOUD_TOP;
    float CLOUD_BOTTOM;
    float CloudStepSize;
    float ShadowStepSize;
};

struct Lightning {
    float3 origin;
    float _pad0;
    float3 direction;
    float segmentLength;
};

StructuredBuffer<Lightning> Lightnings;
uint _LightningCount;

struct Ray {
    float3 origin;
    float3 direction;
};

static const float SHELL_INNER     = 6400*100;
static const float SHELL_OUTER     = 6500*100;
static const float SHELL_THICKNESS = SHELL_OUTER - SHELL_INNER;
static const float PLANET_THICKNESS = 6300*100; //630.000
static const float LIGHTNING_MAX_DISTANCE = 20*100;

//Currently unused
float2 RayBoxIntersect(float3 boundsMin, float3 boundsMax, float3 rayOrigin, float3 rayDir) {
    float3 t0 = (boundsMin - rayOrigin) / rayDir;
    float3 t1 = (boundsMax - rayOrigin) / rayDir;
    float3 tmin = min(t0, t1);
    float3 tmax = max(t0, t1);
    float dstA = max(max(tmin.x, tmin.y), tmin.z);
    float dstB = min(tmax.x, min(tmax.y, tmax.z));
    return float2(dstA, dstB);
}

Ray GenerateRay(uint2 pixelCoord, uint eyeIndex) {
    float2 uv = (float2(pixelCoord) + 0.5) / _FullResolution;

    if (_FlipY == 1)
    uv.y = 1.0 - uv.y;

    float2 ndc = uv * 2.0 - 1.0;

    float4 clip = float4(ndc, 1, 1);

    float4 view = mul(_CameraInvProjPerEye[eyeIndex], clip);

    // perspective divide
    view.xyz /= view.w;

    float3 worldPos = mul(_CameraToWorldPerEye[eyeIndex], float4(view.xyz,1)).xyz;

    float3 camPos =
    mul(_CameraToWorldPerEye[eyeIndex], float4(0,0,0,1)).xyz;

    Ray ray;

    ray.origin = camPos + float3(0, PLANET_THICKNESS, 0);

    ray.direction = normalize(worldPos - camPos);

    return ray;
}

//3/10 --> 1.5/5
float RemapRange(float val,float oldMin, float oldMax,float newMin, float newMax) {
    return newMin+saturate((val-oldMin)/(oldMax-oldMin))*(newMax-newMin);
}

float2 RaySphereIntersect(float3 rayOrigin, float3 rayDir, float radius) {
    float b    = dot(rayOrigin, rayDir);
    float c    = dot(rayOrigin, rayOrigin) - radius * radius;
    float disc = b * b - c;
    //if (disc < 0.0) return float2(-1, -1);
    float sq = sqrt(abs(disc));
    return float2(-b - sq, -b + sq);
}

float2 IntersectCloudShell(Ray ray) {
    // Camera-relative origin is always (0,0,0)
    float2 inner = RaySphereIntersect(ray.origin, ray.direction, SHELL_INNER);
    float2 outer = RaySphereIntersect(ray.origin, ray.direction, SHELL_OUTER);

    float tMin = abs(inner.y);
    float tMax = abs(outer.y);
    //if (tMax <= 0.0 || tMax <= tMin) return float2(-1, -1);
    return float2(tMin, tMax);
}

//Check if in shell
bool isInShell(float3 Worldpos) {
    float dist = length(Worldpos);
    if(dist>= SHELL_INNER && dist <= SHELL_OUTER) {
        return true;
    }
    return false;
}
int SelectMipForWorldPos(float3 Pos) {
    //Choose mipmap level based on angle 
    //(0,1,0) = up = closest = max mip 
    //(1,0,0) = sidewards = at horizon = min mip
    return 0; //stability for cache has more impact than sampling a simpler mip level :/
    Pos = normalize(Pos);
    if(Pos.y > 0.9) {
        return 0;
    }
    if(Pos.y > 0.4) {
        return 1;
    }
    if(Pos.y > 0.1) {
        return 2;
    }
    return 3;
}

float ComputeAdjCloudCoverage(float cloudCoverage) {
    const float cloudHeightScale     = 1.0;
    const float minAdjCloudCoverage  = saturate(0.0127 / (cloudHeightScale + 0.153));
    const float maxAdjCloudCoverage  = saturate(0.125 / (cloudHeightScale + 0.146) - 0.069) + 1.0;
    return lerp(minAdjCloudCoverage, maxAdjCloudCoverage, cloudCoverage);
}

float GetCloudDensity(float3 WorldPos, float MipMap, float adjCloudCoverage) {
    // Inline shell check using the same sqrt we need anyway for heightInShell.
    // (Was: isInShell() did length(), then we did sqrt(dot(WorldPos,WorldPos))
    // again. One length() call here, reused below.)
    float dist = length(WorldPos);
    if (dist < SHELL_INNER || dist > SHELL_OUTER) return 0;

    float cloudCoverage = CloudDensity;
    float Adjusted_Bottom = CLOUD_BOTTOM;
    float Adjusted_Top = CLOUD_TOP;

    float ShapeTiling = 0.00001;
    float3 ShapeNoisePos = WorldPos*ShapeTiling*Scale;// From 1 = 1/1000 to 1000 = 1
    ShapeNoisePos += Offset;
    float2 ShapeNoise = ShapeTexture.SampleLevel(sampler_Trilinear_repeat, ShapeNoisePos,MipMap).xy;
    float ShapeWorley = ShapeNoise.x;
    float ShapePerlin = ShapeNoise.y;

    float heightInShell = saturate((dist - SHELL_INNER) / SHELL_THICKNESS);
    float height = heightInShell * CLOUD_TOP;
    float topHeight = Adjusted_Top;
    float bottomHeight = ShapeWorley*Adjusted_Bottom;
    float topHeightFade = RemapRange(height/topHeight,0.8,1.1,1.0,0.0);
    float bottomHeightFade = RemapRange(height,bottomHeight,bottomHeight+Adjusted_Bottom,0.0,1.0);
    float heightShift = RemapRange(height,Adjusted_Bottom,topHeight,1.0,0.0)*bottomHeightFade;
    float noiseShift = 0.05*(1.0-heightShift);
    float thresholdShift  = 0.1*heightShift;
    float heightFade = topHeightFade*bottomHeightFade;
    float noiseScale = RemapRange(height/topHeight,0.0,0.5,0.5,1.0);

    float Density = RemapRange(ShapePerlin-noiseShift,ShapeWorley-thresholdShift,1.0,0.0,1.0);
    Density = RemapRange(Density, 1.0 - adjCloudCoverage, 1.0, 0.0, 1.0);
    Density *= heightFade;
    Density *= cloudCoverage;
    if (Density < 0.02) return 0;
    float3 DetailNoisePos = ShapeNoisePos*10.0;
    float DetailNoise = DetailTexture.SampleLevel(sampler_Trilinear_repeat,DetailNoisePos,0).x;
    float sharpDetail = DetailNoise * DetailNoise; 
    Density = RemapRange(Density, 0.5 * sharpDetail * noiseScale, 1.0, 0.0, 1.0);
    return Density;
}
//SChneider GPU7
float HGPhase(float cos_angle, float inG) {
    float  denomBase = abs(1.0 + inG * inG - 2.0 * inG * cos_angle);
    float  denom     = denomBase * sqrt(denomBase);

    return ((1.0 - inG * inG) / denom) / 4.0 * 3.1415;
}
//Doom
float HGPhase2Lobe(float VdotL, float g0, float g1, float weight1) {
    return lerp(HGPhase(VdotL,g0),HGPhase(VdotL,g1),weight1);
}
bool GetLightSourceDirection(float3 WorldPos, out float3 Dir,out float dist) {
    float3 bestDelta    = SunDirection; 
    float  bestDistSq   = LIGHTNING_MAX_DISTANCE * LIGHTNING_MAX_DISTANCE;
    bool   hitAny       = false;

    for (uint i = 0; i < _LightningCount; i++) {
        float3 LightningPos = Lightnings[i].origin;
        float3 toPos  = WorldPos - LightningPos;
        float  t      = clamp(dot(toPos, Lightnings[i].direction), 0.0, Lightnings[i].segmentLength);
        float3 closest = LightningPos+ Lightnings[i].direction * t;

        float3 delta  = closest - WorldPos;
        float  distSq = dot(delta, delta);

        if (distSq < bestDistSq) {
            bestDistSq = distSq;
            bestDelta  = delta;
            hitAny     = true;
        }
    }
    if(hitAny) {
        Dir = bestDelta;
        dist = bestDistSq;
        return true;
    }
    return false;
}
//Mostly Doom based
float4 RayMarch(float3 viewPos, float3 viewDir, float tMin, float tMax, out float depth, float Noise, int eyeIndex) {
    int numShadowSteps = 6;
    float VdotL = dot(viewDir,SunDirection);//TODO Atteniate based on how much of color is suncolor

    const float betaE = 0.003;//Extinction coeff at cloud density = 1, value guessed. Basicly how fast we stop marching in a clouds
    float sigS_over_sigE = BrightnesMultiplier; //general energy multiplier

    float t = tMin;
    float transmittance = 1.0;
    float sunInScatterN0 = 0.0;
    float sunInScatterN1 = 0.0;
    float ambientInScatterN = 0.0;
    float LightningScatter = 0.0;
    float distSum = 0.0;

    //Stepping optimisation
    int stepsWithoutCloud = 0;
    int LightningCount = 0;
    float OverallLightningDist = 0;
    bool BigSteps = true;
    const float BigStepMultiplier = 3.0;

    float rayOffset = (Noise - 0.5) * 0.1 * CloudStepSize;
    viewPos += viewDir*rayOffset;
    float MipMap = SelectMipForWorldPos(viewPos);
    float adjCloudCoverage = ComputeAdjCloudCoverage(CloudDensity);
    int steps = 0;
    //Iterate from cloud entry to cloud exit position, based on the ray length
    while(t<tMax && steps < 10000) {
        steps++;
        float3 samplePos = viewPos +t*viewDir;
        if(samplePos.y-PLANET_THICKNESS <-10000) {
            break;
        }

        float stepSize;
        if (BigSteps) {
            stepSize = CloudStepSize * BigStepMultiplier;
        } else {
            stepSize = transmittance > 0.5 ? CloudStepSize :
            transmittance > 0.2 ? CloudStepSize * 1.5 :
            CloudStepSize * 2.5;
        }

        float density = GetCloudDensity(samplePos,MipMap,adjCloudCoverage);
        float shadowOpticalDepth = 0.0;
        float LightningOpticalDepth = 0.0;
        if(density > 0) {
            stepsWithoutCloud = 0;
            if(BigSteps) {
                //revert big step and start small steps to find exact cloud start
                BigSteps = false;
                t -= stepSize;
                continue;
            }

            float3 samplePosShadow = samplePos;
            float prevShadowDensity = density;
            //SUN
            float3 sunDir = SunDirection;

            int adaptiveShadowSteps = numShadowSteps;

            for(int i=0;i<adaptiveShadowSteps;++i) {
                samplePosShadow += ShadowStepSize*sunDir;
                float shadowDensity = GetCloudDensity(samplePosShadow,MipMap,adjCloudCoverage)*TransmittanceFalloff;
                shadowOpticalDepth += betaE*((prevShadowDensity+shadowDensity)*0.5)*ShadowStepSize;
                prevShadowDensity = shadowDensity;
            }

            float sigE = betaE*density;
            float powder = 4.0*(1.0-exp(-2.0*density));
            float shadowTransmittance = exp(-shadowOpticalDepth);

            float nextTransmittance = transmittance*exp(-sigE*stepSize);
            float _dTr = transmittance-nextTransmittance;
            //LIGHTNING
            samplePosShadow = samplePos;
            prevShadowDensity = density;
            float curDist = 0;
            if(GetLightSourceDirection(samplePos,sunDir,curDist)) {
                OverallLightningDist+= curDist;

                for(int i=0;i<adaptiveShadowSteps;++i) {
                    samplePosShadow += ShadowStepSize*sunDir;
                    float shadowDensity = GetCloudDensity(samplePosShadow,MipMap,adjCloudCoverage)*TransmittanceFalloff;
                    LightningOpticalDepth += betaE*((prevShadowDensity+shadowDensity)*0.5)*ShadowStepSize;
                    prevShadowDensity = shadowDensity;
                }
                LightningScatter += exp(-LightningOpticalDepth)*_dTr;
            }

            //Sunscatter = How much sun gets bounced to our pos from other parts of the cloud
            sunInScatterN0 += sigS_over_sigE*lerp(1, powder, PowderStrength)*shadowTransmittance*_dTr; //Two Octaves of sunshine, doom innovation
            sunInScatterN1 += 0.5*sigS_over_sigE*lerp(1, powder, PowderStrength)*sqrt(shadowTransmittance)*_dTr; //Lerp powder, because lowkey cringe for dark borders around cloud

            ambientInScatterN += sigS_over_sigE *powder*_dTr;
            distSum +=t*_dTr;

            transmittance = nextTransmittance;
            if(transmittance<0.01) break;
        }else {
            if(!BigSteps) {
                stepsWithoutCloud +=1;
                if(stepsWithoutCloud > BigStepMultiplier+1) {
                    BigSteps = true;
                    stepsWithoutCloud = 0;
                }
            }
        }

        t += stepSize;
    }

    const float anisotropyFront = 0.9;
    const float anisotropyBack = -0.1;
    const float backLobeWeight = 0.9;

    //Angle aligns with directly looking at sun -> extra light because sun doesnt like going around corners :P
    sunInScatterN0 *= lerp(HGPhase2Lobe(VdotL,anisotropyFront,anisotropyBack,backLobeWeight),0.5,1-SunBlindingEffectSize*2);
    sunInScatterN1 *= lerp(HGPhase2Lobe(VdotL,0.5*anisotropyFront,0.5*anisotropyBack,backLobeWeight),0.5,1-SunBlindingEffectSize);

    float ambientInScatterFinalNoPowder = (1-transmittance)*sigS_over_sigE;
    float ambientInScatterFinal = lerp(ambientInScatterFinalNoPowder, ambientInScatterN, 0.35);
    ambientInScatterFinal *= 1.0/(4.0*3.1415);

    float avgCloudDist = distSum /(1.0-transmittance);
    if(transmittance<1) {
        depth= avgCloudDist;
    }else {
        depth =length(viewPos +tMax*viewDir); // Fallback for cirrus
    }

    float3 ambientIrradiance = float3(0.55, 0.65, 0.85)*AmbiantLight;

    float3 sunIrradiance = normalize(SunColor)*SunIntensity;
    float LightningMultiplier = 0;
    if(LightningCount>0) {
        LightningMultiplier = 1-(OverallLightningDist/LightningCount)/(LIGHTNING_MAX_DISTANCE*LIGHTNING_MAX_DISTANCE);
    }
    float3 inScatter = (sunInScatterN0+sunInScatterN1)*sunIrradiance + ambientInScatterFinal*ambientIrradiance;
    inScatter = lerp(inScatter,inScatter+LightningScatter*float3(0,0,1)*LightningMultiplier,LightningMultiplier);
    return float4(inScatter,1-transmittance);
}

uint2 ConvertQuarterToFullRes(uint2 QuarterPixel) {
    //Scale up by 4 and decide current pos in 4x4 square to achieve 16 pixel temporal
    //Scale 4x4 up to 16x16
    //(0,0) ->(0-3,0-3)
    //(1,0) -> (4-7,0-3)
    //(2,0) -> (8-11,0-3)
    //(3,0) -> (12-15,0-3)
    //Multiply by 4 and add offset
    //Offset is simply row by row, possibly check board this ?

    QuarterPixel *=_BigDivider;
    uint FrameSlot = _FrameIndex % (_BigDivider*_BigDivider);
    uint2 PixelOffset = uint2(FrameSlot % _BigDivider, FrameSlot / _BigDivider);
    return QuarterPixel+PixelOffset;
}
[numthreads(8, 8, 1)]
void CloudRaymarch(uint3 id : SV_DispatchThreadID) {
    if (id.x >= (uint)_Resolution.x || id.y >= (uint)_Resolution.y) return;
    uint2 FullResPixel = ConvertQuarterToFullRes(id.xy);

    if(_DepthTex[uint3(FullResPixel, id.z)] >0.1) {
        _CloudColorBuffer[id.xyz] = float3(0, 0, 0);
        _CloudAlphaBuffer[id.xyz] = 1;
        _CloudDepthTex[id.xyz] = 0;

        return;
    }
    Ray ray = GenerateRay(FullResPixel,id.z);
    float2 intersection = IntersectCloudShell(ray);

    if (intersection.x < 0 || intersection.y < intersection.x) {
        _CloudColorBuffer[id.xyz] = float3(0, 0, 0);
        _CloudAlphaBuffer[id.xyz] = 1;
        _CloudDepthTex[id.xyz] = 0;
        return;
    }
    float depth = 0;

    float blueNoise = BlueNoise.SampleLevel(sampler_Trilinear_repeat, id.xy/(_Resolution*0.2), 0).x;
    float4 result =  RayMarch(ray.origin, ray.direction,intersection.x,intersection.y,depth,blueNoise, id.z);
    if(result.w > 0) {
        _CloudColorBuffer[id.xyz] = result.rgb;
        _CloudAlphaBuffer[id.xyz] = result.w;
        _CloudDepthTex[id.xyz] = depth;
    }else {
        _CloudColorBuffer[id.xyz] = float3(0, 0, 0);
        _CloudAlphaBuffer[id.xyz] = 0;
        _CloudDepthTex[id.xyz] =0;
    }
}